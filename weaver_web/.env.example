# Base URL of the Weaver backend API.
VITE_API_URL=http://localhost:8000

# Firebase web config, used to save canvases to Firestore.
# Get these from the Firebase console: Project settings > General > Your apps
# > Web app > SDK setup and configuration. Leave them unset to run without the
# save/load features (the app still works).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
