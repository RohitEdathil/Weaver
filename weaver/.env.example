# Google Gemini API key. Used for models served directly by Google
# (e.g. the "fast" visualizer mode).
GOOGLE_API_KEY=

# OpenCode Zen API key. Used for OpenAI-compatible models routed through the
# Zen gateway (e.g. the "accurate" visualizer mode).
OPENCODE_API_KEY=

# Optional: override the Zen gateway base URL.
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Optional: visualizer mode, either "fast" or "accurate" (default: fast).
# VISUALIZER_MODE=fast
