# Google Gemini API key. Used for models served directly by Google
# (e.g. the "fast" visualizer mode).
GOOGLE_API_KEY=

# OpenCode Zen API key. Used for OpenAI-compatible models routed through the
# Zen gateway (e.g. the "accurate" visualizer mode).
OPENCODE_API_KEY=

# Optional: override the Zen gateway base URL.
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Optional: visualizer mode, either "fast" or "accurate" (default: fast).
# VISUALIZER_MODE=fast

# Optional: the Gemini Live model backing the converser voice agent. Must be a
# Live-capable Gemini model.
# CONVERSER_MODEL=gemini-3.8-live

# Optional: LangSmith tracing. Set LANGSMITH_TRACING=true and provide an API
# key to trace visualizer agent runs (tool calls, LLM interactions) and the
# converser's live voice session (transcripts, turns, interruptions) in
# LangSmith.
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=weaver
